# =====================================================================
# OTTIMO Desk – environment variables (TEMPLATE ONLY)
# Copy to product/.env for local dev:   cp .env.example .env
# NEVER put real keys/passwords in this file or in git. Real values live only in
# product/.env on each machine/server (chmod 600) – see docs/dev-setup.md, docs/hosting-plan.md.
# Values below are placeholders, mode switches (mock/manual) or empty.
# Startup check (integrations/common/safe-config.ts, assertSafeConfig – called by services/api config.ts):
#   all envs   every selector below must hold an allowed value (README section 4), e.g. VietQR has no
#              sandbox; PAYMENT_METHODS_ENABLED / PAYMENT_<X>_MODE only know vietqr|vnpay|momo.
#   production (a) no *_PROVIDER / *_MODE = mock or sandbox (unused gateways: off);
#              (b) every method listed in PAYMENT_METHODS_ENABLED must have PAYMENT_<X>_MODE=production
#                  (dev/test/staging only hide a listed method whose MODE=off) – so copying this file
#                  unchanged to production FAILS on purpose (vietqr is listed, PAYMENT_VIETQR_MODE=off);
#              (c) no *_MOCK_SCENARIO may be set (non-empty): delete or empty CHANNEL_MOCK_SCENARIO and
#                  PAYMENT_MOCK_SCENARIO in production.
# The api/worker refuse to start and name the variables (never their values).
# =====================================================================

# ---------- Core (ARC – architecture.md section 13) ----------
# APP_ENV decides dev-only behaviour (CLOCK_MODE=mutable, test-support endpoints, mock adapters), NOT NODE_ENV.
# One of: dev | test | staging | production. The api/worker refuse to start without it.
APP_ENV=dev
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Used by the api/tests when they run on the host (pnpm --filter @ottimo/api dev / pnpm test).
# Inside docker compose the api gets its own DATABASE_URL pointing at the postgres service.
# Runtime role = ottimo_app (NOSUPERUSER NOBYPASSRLS) – never the POSTGRES_USER superuser.
DATABASE_URL=postgres://ottimo_app:change_me_app_dev_only@localhost:5432/ottimo
# Migrations only (R2: pnpm db:migrate). Role ottimo_migrator (LOGIN) runs `SET ROLE ottimo_owner`;
# ottimo_owner itself is NOLOGIN (erd.md 2.1, BUG-R1-SEC-06). Never given to api/worker.
MIGRATION_DATABASE_URL=postgres://ottimo_migrator:change_me_migrator_dev_only@localhost:5432/ottimo
APP_BASE_URL=http://localhost:8081
GUEST_BASE_URL=http://localhost:8083
# Landing page origin (US-155 "Yêu cầu đặt phòng" – the ONLY Origin accepted by the public form calls).
# Empty = the public form answers 404. https outside dev/test. The form itself stays OFF until the owner turns
# on parameter public_booking_requests_enabled (US-155 AC4).
LANDING_BASE_URL=
# Declaration portals opened from "Dữ liệu cổng khai báo" (BR-606, ARC FB-R2-ARC-BE-S3-20). https only;
# empty = the defaults below. Staff log in on the portal themselves – no credential is stored here.
GUEST_REGISTRATION_PORTAL_URL_FOREIGNER=https://tbltkbtt.bocongan.gov.vn
GUEST_REGISTRATION_PORTAL_URL_VN=https://dichvucong.bocongan.gov.vn
# Proxies whose X-Forwarded-For is trusted: empty (trust none – dev default) or IP/CIDR list (hop counts rejected).
# REQUIRED in staging/production (the api refuses to start without it): the Caddy container IP/subnet,
# internal ranges only (loopback, 10/8, 172.16/12, 192.168/16, ::1, fc00::/7 – FB-R2-SEC-BE-01/02).
# Prefixes wider than /8 (IPv4) or /16 (IPv6), "true" and hop counts are rejected at startup.
TRUST_PROXY=
# SR-RL-09: requests per staff user and minute before 429 RATE_LIMITED (empty = 600). dev/test may raise it
# (E2E with shared qa.* accounts on parallel workers – BUG-R2-051); staging/production may only lower it.
STAFF_REQUESTS_PER_MINUTE=
# US-143 / SR-AUTH-06 (SEC 06.3): owner/manager must use two-step login. true|false, empty = false.
# dev/CI default false (old E2E keep working). Staging: true before real data (cổng dữ liệu thật).
# production refuses to start when it is not true.
MFA_ENFORCED=false
# Secrets below: empty is allowed only for APP_ENV=dev|test. staging/production refuse to start
# when one is missing or shorter than 32 characters (DATA_KEK_CURRENT: exactly 32 bytes, base64).
# Generate:  openssl rand -base64 32
# Any variable can instead be read from a file: set X_FILE=/run/secrets/x (Docker secrets, 0400).
SESSION_SECRET=
# Envelope encryption master key for C3 data (ADR-013). One per environment, keep off-repo.
# dev/test EMPTY = a temporary random key per process: documents written before a restart can no longer be
# opened, and the api/worker log one `warn` line "crypto: temporary random keys" (S4-46). Set it (and
# ID_HASH_KEY) in product/.env for any stack you keep data in: openssl rand -base64 32
DATA_KEK_CURRENT=
DATA_KEK_VERSION=1
# HMAC key for ID-number matching (ADR-013 section 5) – blind index of document numbers + the v1 guest
# document key (HKDF `guest_doc`). dev/test empty = temporary, same warning as above. >= 32 characters.
ID_HASH_KEY=
# HMAC key for client IPs in logs/audit (SR-KEY-08)
LOG_IP_HMAC_KEY=
# HMAC-SHA256 key for guest verification codes (email OTP, desk codes – guest_verification_code.code_hash).
# One key per purpose (ADR-013 point 5, BUG-R1-SEC-07): never reuse ID_HASH_KEY or LOG_IP_HMAC_KEY here.
# staging/production: >= 32 characters, from a Docker secret (GUEST_CODE_SIGNING_KEY_FILE).
GUEST_CODE_SIGNING_KEY=
# HMAC key of the signed one-time form token of the website booking form (ADR-014 4.4, US-155). Its own key
# (never reuse another one); >= 32 characters; staging/production from PUBLIC_FORM_SIGNING_KEY_FILE.
# Empty = no form token (the owner cannot switch the form on – 422 PUBLIC_FORM_NOT_READY).
PUBLIC_FORM_SIGNING_KEY=
BLOBSTORE_PROVIDER=local
BLOBSTORE_LOCAL_PATH=./.data/blobs

# ---------- Web Push (R3, US-164 – ARC s1-contracts 3; ADR-005) ----------
# VAPID key pair (EC P-256, base64url without padding): public = 65-byte point, private = 32-byte scalar. One pair per
# environment; changing it invalidates every push subscription. dev: generate locally (npx web-push generate-vapid-keys)
# or leave empty (no Web Push, in-app + SSE only). staging/production: generated ON the server by
# infra/server/bin/init-secrets.sh into *_FILE secrets – never typed, never in git.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact of the push sender required by VAPID (mailto: of the team mailbox).
WEB_PUSH_SUBJECT=mailto:ops@example.invalid

# ---------- Website (landing) booking form – v1.1, US-155 (ADR-014 4) ----------
# Origin of the landing site allowed to call the public form endpoints (https in staging/production; empty = the
# website form is off – v1.0 goes live without it).
LANDING_BASE_URL=
# HMAC key of the signed form token (>= 32 characters, its own purpose – never reuse another key). staging/production
# read it from a Docker secret file written by init-secrets.sh; dev may set PUBLIC_FORM_SIGNING_KEY instead.
PUBLIC_FORM_SIGNING_KEY_FILE=

# ---------- Web build (infra/docker/Dockerfile.web build args – UXR P-15) ----------
# Front desk phone baked into the staff PWA ("Sự cố gấp? Gọi lễ tân ngay" button) and the guest web (expired-link
# page) at BUILD time – changing it needs a new web image. Public number, not a secret, but the real one lives
# only in product/.env on the machine that builds (never committed); CI production images read the repository
# variable VITE_DESK_PHONE.
# Format = the apps' rule: digits and spaces, one optional leading +, 6–20 characters ("0xx xxxx xxxx",
# "+84 xx xxxx xxxx"); dots, dashes or brackets hide the button and are refused by the build.
# dev: optional (empty = no button; this all-zero placeholder = a button that calls a dummy number).
# demo (infra/demo/demo-up.sh) and production builds STOP when it is missing, malformed or still this placeholder
# (infra/docker/check-web-build-config.sh).
VITE_DESK_PHONE=0000 000 000

# ---------- Clock and test-only endpoints (ADR-008, architecture 13, docs/api/openapi.test.yaml) ----------
# CLOCK_OVERRIDE was removed (R2): setting it to any non-empty value now stops the api/worker.
# system  = real time (production: the only allowed value)
# mutable = shared fake clock in table dev_clock (api + worker), moved via POST /__test__/clock.
CLOCK_MODE=mutable
# Runtime switch for /__test__/* (clock, run job). 1 = load them; forbidden in production.
# In docker compose the same variable is also the api image build-arg: 0 removes dist/test-support
# from the image (production images are always built with 0).
INCLUDE_TEST_SUPPORT=1
# Required (>= 32 characters) when INCLUDE_TEST_SUPPORT=1; sent as X-Test-Token together with an owner
# session. Must differ from every other key. Must be EMPTY in production. Generate: openssl rand -hex 24
TEST_SUPPORT_TOKEN=change_me_test_support_token_dev_only
# true = session cookies use the __Host- prefix (needs HTTPS). false is accepted only for APP_ENV=dev|test
# (local http://localhost; WebKit drops Secure cookies on plain http). staging/production: true.
COOKIE_SECURE_PREFIX=false

# ---------- QA seed (tests/fixtures/seed – DS-E/DS-0, test-strategy 0.3 section 4) ----------
# Password the seed loader (pnpm seed:ds-e / seed:ds-0, BE sprint 1) sets on every qa.* account.
# dev/test/staging only – never set in production. Placeholder below is for local dev; CI generates a
# random one per run (infra/ci/make-ci-env.sh); staging gets its own from the server's .env / secret.
QA_SEED_PASSWORD=change_me_qa_seed_dev_only

# ---------- Local PostgreSQL (docker compose dev only) ----------
# Superuser for administration only (init scripts, psql). The application never uses it.
POSTGRES_USER=ottimo_admin
POSTGRES_PASSWORD=change_me_admin_dev_only
POSTGRES_DB=ottimo
# Passwords of the roles created by infra/postgres/init/02-roles.sh – keep in sync with the URLs above.
# ottimo_owner is NOLOGIN and has no password.
OTTIMO_MIGRATOR_DB_PASSWORD=change_me_migrator_dev_only
OTTIMO_APP_DB_PASSWORD=change_me_app_dev_only
# Optional: host port of the dev PostgreSQL (default 5432) – e.g. a second, throwaway compose project
# (COMPOSE_PROJECT_NAME=ottimo-ci) next to the running dev stack.
# POSTGRES_HOST_PORT=5432

# ---------- Integrations (INT – integrations/README.md section 4, interface v0.2) ----------
# Default for every gateway: off (not registered, no webhook route). Production rejects mock/sandbox.
# Owner, minimum scope and rotation of each secret: docs/integrations.md 4.1 + docs/hosting-plan.md 8.1.
# Channel manager
CHANNEL_PROVIDER=off
CHANNEL_MOCK_SCENARIO=ok
CHANNEL_BEDS24_API_BASE=
CHANNEL_BEDS24_REFRESH_TOKEN=
CHANNEL_WEBHOOK_PATH_TOKEN=
CHANNEL_SYNC_FAILURE_ALERT_MINUTES=15
# Payment
PAYMENT_METHODS_ENABLED=vietqr
PAYMENT_MOCK_SCENARIO=ok
PAYMENT_VIETQR_MODE=off
# VietQR receiving account: NOT an environment variable (SEC-INT-06). OWN enters it in the app (Parameters →
# payment_receiving_account, password re-auth, audit). PAYMENT_VIETQR_BANK_BIN / _ACCOUNT_NO / _ACCOUNT_NAME are
# retired: the api refuses to start when any of them is non-empty.
PAYMENT_VNPAY_MODE=off
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_HASH_SECRET=
PAYMENT_VNPAY_PAY_URL=
PAYMENT_VNPAY_API_URL=
PAYMENT_MOMO_MODE=off
PAYMENT_MOMO_PARTNER_CODE=
PAYMENT_MOMO_ACCESS_KEY=
PAYMENT_MOMO_SECRET_KEY=
PAYMENT_MOMO_ENDPOINT=
BANKFEED_PROVIDER=off
BANKFEED_WEBHOOK_SECRET=
BANKFEED_API_KEY=
BANKFEED_SOURCE_IP_ALLOWLIST=
# E-invoice
EINVOICE_PROVIDER=off
EINVOICE_MISA_BASE_URL=
EINVOICE_MISA_APP_ID=
EINVOICE_MISA_TAX_CODE=
EINVOICE_MISA_USERNAME=
EINVOICE_MISA_PASSWORD=
# Door lock
DOORLOCK_PROVIDER=manual
DOORLOCK_TTLOCK_CLIENT_ID=
DOORLOCK_TTLOCK_CLIENT_SECRET=
# Notification
# E-mail (INT R3, INV 23/10/2026: Google Workspace SMTP from info@ottimo.vn). dev: mock. To try a local fake SMTP
# server set smtp + EMAIL_SMTP_HOST/PORT – the app password is ONLY read from a file (EMAIL_SMTP_PASSWORD_FILE);
# staging/production refuse a raw EMAIL_SMTP_PASSWORD. EMAIL_SMTP_URL / EMAIL_SES_REGION are retired.
# EMAIL_SMTP_MODE: relay (default – Google Workspace SMTP relay by server IP, no password; SEC EMAIL-01 A) |
# app_password (fallback). Empty HOST/PORT = the default of the mode.
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_SMTP_MODE=relay
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD_FILE=
ZALO_PROVIDER=manual_copy
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
