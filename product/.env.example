# =====================================================================
# OTTIMO Desk – environment variables (TEMPLATE ONLY)
# Copy to product/.env for local dev:   cp .env.example .env
# NEVER put real keys/passwords in this file or in git. Real values live only in
# product/.env on each machine/server (chmod 600) – see docs/dev-setup.md, docs/hosting-plan.md.
# Values below are placeholders, mode switches (mock/manual) or empty.
# Production rejects any *_PROVIDER / *_MODE = mock at startup (unused gateways: set to off).
# =====================================================================

# ---------- Core (ARC – architecture.md section 13) ----------
# APP_ENV decides dev-only behaviour (CLOCK_OVERRIDE, mock adapters), NOT NODE_ENV.
# One of: dev | test | staging | production. The api/worker refuse to start without it.
APP_ENV=dev
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Used by the api/tests when they run on the host (pnpm --filter @ottimo/api dev / pnpm test).
# Inside docker compose the api gets its own DATABASE_URL pointing at the postgres service.
# Runtime role = ottimo_app (NOSUPERUSER NOBYPASSRLS) – never the POSTGRES_USER superuser.
DATABASE_URL=postgres://ottimo_app:change_me_app_dev_only@localhost:5432/ottimo
# Migrations only (R2: pnpm db:migrate). Role ottimo_owner owns the schema; never given to api/worker.
MIGRATION_DATABASE_URL=postgres://ottimo_owner:change_me_owner_dev_only@localhost:5432/ottimo
APP_BASE_URL=http://localhost:8081
GUEST_BASE_URL=http://localhost:8083
# Proxies whose X-Forwarded-For is trusted: empty (trust none – dev default), hop count, or IP/CIDR list.
# Production: the Caddy container IP/subnet. "true" is rejected at startup.
TRUST_PROXY=
# Secrets below: empty is allowed only for APP_ENV=dev|test. staging/production refuse to start
# when one is missing or shorter than 32 characters (DATA_KEK_CURRENT: exactly 32 bytes, base64).
# Generate:  openssl rand -base64 32
# Any variable can instead be read from a file: set X_FILE=/run/secrets/x (Docker secrets, 0400).
SESSION_SECRET=
# Envelope encryption master key for C3 data (ADR-013). One per environment, keep off-repo.
DATA_KEK_CURRENT=
DATA_KEK_VERSION=1
# HMAC key for ID-number matching (ADR-013 section 5)
ID_HASH_KEY=
# HMAC key for client IPs in logs/audit (SR-KEY-08)
LOG_IP_HMAC_KEY=
# Signing key for guest verification codes / OTP (SR-GST, R2 – BE decides the final name with SEC)
GUEST_CODE_SIGNING_KEY=
BLOBSTORE_PROVIDER=local
BLOBSTORE_LOCAL_PATH=./.data/blobs
# dev/test/staging only – rejected at startup when APP_ENV=production (ADR-008). Example: 2026-10-15T09:00:00+07:00
CLOCK_OVERRIDE=

# ---------- Local PostgreSQL (docker compose dev only) ----------
# Superuser for administration only (init scripts, psql). The application never uses it.
POSTGRES_USER=ottimo_admin
POSTGRES_PASSWORD=change_me_admin_dev_only
POSTGRES_DB=ottimo
# Passwords of the roles created by infra/postgres/init/02-roles.sh – keep in sync with the URLs above.
OTTIMO_OWNER_DB_PASSWORD=change_me_owner_dev_only
OTTIMO_APP_DB_PASSWORD=change_me_app_dev_only

# ---------- Integrations (INT – integrations/README.md section 4) ----------
# Channel manager
CHANNEL_PROVIDER=mock
CHANNEL_BEDS24_API_BASE=
CHANNEL_BEDS24_REFRESH_TOKEN=
CHANNEL_WEBHOOK_SECRET=
# Payment
PAYMENT_VIETQR_BANK_BIN=
PAYMENT_VIETQR_ACCOUNT_NO=
PAYMENT_VIETQR_ACCOUNT_NAME=
PAYMENT_VNPAY_MODE=mock
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_HASH_SECRET=
PAYMENT_VNPAY_PAY_URL=
PAYMENT_VNPAY_API_URL=
PAYMENT_MOMO_MODE=mock
PAYMENT_MOMO_PARTNER_CODE=
PAYMENT_MOMO_ACCESS_KEY=
PAYMENT_MOMO_SECRET_KEY=
PAYMENT_MOMO_ENDPOINT=
BANKFEED_PROVIDER=none
BANKFEED_WEBHOOK_SECRET=
# E-invoice
EINVOICE_PROVIDER=mock
EINVOICE_MISA_BASE_URL=
EINVOICE_MISA_APP_ID=
EINVOICE_MISA_TAX_CODE=
EINVOICE_MISA_USERNAME=
EINVOICE_MISA_PASSWORD=
# Door lock
DOORLOCK_PROVIDER=manual
DOORLOCK_TTLOCK_CLIENT_ID=
DOORLOCK_TTLOCK_CLIENT_SECRET=
# Notification
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_SMTP_URL=
ZALO_PROVIDER=manual_copy
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
