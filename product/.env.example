# =====================================================================
# OTTIMO Desk – environment variables (TEMPLATE ONLY)
# Copy to product/.env for local dev:   cp .env.example .env
# NEVER put real keys/passwords in this file or in git. Real values live only in
# product/.env on each machine/server (chmod 600) – see docs/dev-setup.md, docs/hosting-plan.md.
# Values below are placeholders, mode switches (mock/manual) or empty.
# =====================================================================

# ---------- Core (ARC – architecture.md section 13) ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Used by the api when it runs on the host (pnpm --filter @ottimo/api dev).
# Inside docker compose the api gets its own DATABASE_URL pointing at the postgres service.
DATABASE_URL=postgres://ottimo:change_me_dev_only@localhost:5432/ottimo
APP_BASE_URL=http://localhost:8081
GUEST_BASE_URL=http://localhost:8083
SESSION_SECRET=
# Envelope encryption master key for C3 data (ADR-013). Generate per environment, keep off-repo.
DATA_KEK_CURRENT=
DATA_KEK_VERSION=1
# HMAC key for ID-number matching (ADR-013 section 5)
ID_HASH_KEY=
BLOBSTORE_PROVIDER=local
BLOBSTORE_LOCAL_PATH=./.data/blobs
# Dev/staging only – ignored when NODE_ENV=production (ADR-008). Example: 2026-10-15T09:00:00+07:00
CLOCK_OVERRIDE=

# ---------- Local PostgreSQL (docker compose dev only) ----------
POSTGRES_USER=ottimo
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=ottimo

# ---------- Integrations (INT – integrations/README.md section 4) ----------
# Channel manager
CHANNEL_PROVIDER=mock
CHANNEL_BEDS24_API_BASE=
CHANNEL_BEDS24_REFRESH_TOKEN=
CHANNEL_WEBHOOK_SECRET=
# Payment
PAYMENT_VIETQR_BANK_BIN=
PAYMENT_VIETQR_ACCOUNT_NO=
PAYMENT_VIETQR_ACCOUNT_NAME=
PAYMENT_VNPAY_MODE=mock
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_HASH_SECRET=
PAYMENT_VNPAY_PAY_URL=
PAYMENT_VNPAY_API_URL=
PAYMENT_MOMO_MODE=mock
PAYMENT_MOMO_PARTNER_CODE=
PAYMENT_MOMO_ACCESS_KEY=
PAYMENT_MOMO_SECRET_KEY=
PAYMENT_MOMO_ENDPOINT=
BANKFEED_PROVIDER=none
BANKFEED_WEBHOOK_SECRET=
# E-invoice
EINVOICE_PROVIDER=mock
EINVOICE_MISA_BASE_URL=
EINVOICE_MISA_APP_ID=
EINVOICE_MISA_TAX_CODE=
EINVOICE_MISA_USERNAME=
EINVOICE_MISA_PASSWORD=
# Door lock
DOORLOCK_PROVIDER=manual
DOORLOCK_TTLOCK_CLIENT_ID=
DOORLOCK_TTLOCK_CLIENT_SECRET=
# Notification
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_SMTP_URL=
ZALO_PROVIDER=manual_copy
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
