{
  "name": "@ottimo/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "OTTIMO Desk API + worker (NestJS/Fastify) – modular monolith, ADR-001/002",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@ottimo/integrations": "workspace:*",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@ottimo/contracts": "workspace:*",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
