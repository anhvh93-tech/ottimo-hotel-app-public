{
  "name": "@ottimo/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Third-party adapters (owner: INT). contracts/ = types, IntegrationError, IntegrationContext only (ADR-011); notification Mock implemented. Other adapters from R2 per README v0.2.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^4.1.12"
  }
}
