{
  "name": "@ottimo/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Third-party adapters (owner: INT). contracts/ = types only (ADR-011); common/ = scrubCardData, EnvCredentialProvider, assertSafeConfig; qr/ = local QR encoder (browser-safe); payment/ = VietQR; doorlock/ = manual + mock; guest-registration/ = manual; notification Mock.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr/index.js",
      "default": "./dist/qr/index.js"
    },
    "./payment": {
      "types": "./dist/payment/index.d.ts",
      "import": "./dist/payment/index.js",
      "default": "./dist/payment/index.js"
    },
    "./doorlock": {
      "types": "./dist/doorlock/index.d.ts",
      "import": "./dist/doorlock/index.js",
      "default": "./dist/doorlock/index.js"
    },
    "./guest-registration": {
      "types": "./dist/guest-registration/index.d.ts",
      "import": "./dist/guest-registration/index.js",
      "default": "./dist/guest-registration/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.12"
  }
}
