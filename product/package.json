{
  "name": "ottimo-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OTTIMO Desk monorepo (pnpm + Turborepo) – see docs/architecture.md section 17 and ADR-012",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "lint": "eslint . && turbo run typecheck",
    "test": "turbo run test",
    "test:fixtures": "pnpm --filter @ottimo/tests test",
    "test:e2e": "pnpm --filter @ottimo/tests test:e2e",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @ottimo/api db:migrate",
    "seed:ds-e": "pnpm --filter @ottimo/api seed:ds-e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose --env-file .env -f infra/docker-compose.yml up --build",
    "dev:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "dev:web": "turbo run dev --filter=./apps/*",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.7"
    },
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
