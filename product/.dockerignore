# Keep in sync with the root .gitignore secret/data patterns (FB-R1-SEC-OPS-06).
**/node_modules
**/dist
**/.turbo
**/coverage
.env
.env.*
!.env.example
# Secrets, keys, local data and dumps must never enter a build context or image layer
**/.data
**/*.pem
**/*.key
**/*.age
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.kdbx
**/*.dump
**/*.sql.gz
# Not needed to build images. docs/ stays out: R2 commits the types generated from
# docs/api/openapi.yaml into packages/contracts/src/generated (FB-R1-ARC-OPS-06).
# tests/ is kept in the context because tests/e2e becomes a workspace package (lockfile importer).
docs
legacy
# design/ stays out except the three generated files the web build imports
# (packages/ui/src/styles/index.css, packages/i18n/src/translate.ts).
design/**
!design/wireframes/assets/tokens.css
!design/hifi/assets/hifi.css
!design/copy/strings-vi.json
!design/copy/strings-en.json
# guest-web also offers RU (partial draft, EN fallback per key) – MOB R2 S3
!design/copy/strings-ru.json
