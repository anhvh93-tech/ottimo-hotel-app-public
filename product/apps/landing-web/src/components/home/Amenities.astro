---
// 4 · Amenities (concept 3.1): the one place that lists equipment, in 4 groups (DOM 3.3).
import { AMENITIES_PHOTO } from '../../content/gallery';
import type { Copy } from '../../content/types';
import Picture from '../Picture.astro';
import Rich from '../Rich.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="sec" id="amenities" aria-labelledby="amen-h">
  <div class="wrap amen">
    <Picture
      id={AMENITIES_PHOTO}
      lang={t.lang}
      alt={t.photoAlt[AMENITIES_PHOTO]}
      class="r45"
      imgClass="op-x08"
      sizesMobile="calc(100vw - 32px)"
      sizes="(min-width: 1200px) 440px, (min-width: 1024px) 38vw, calc(100vw - 48px)"
    />
    <div>
      <div class="head">
        <p class="label">{t.amenities.label}</p>
        <h2 class="h2" id="amen-h">{t.amenities.title}</h2>
        <p class="muted">{t.amenities.intro}</p>
      </div>
      <ul class="groups">
        {
          t.amenities.groups.map((g) => (
            <li>
              <h3 class="h3">{g.title}</h3>
              <p>
                <Rich text={g.body} />
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
