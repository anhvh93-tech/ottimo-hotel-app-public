---
// 9 · Book direct (US-151): chat apps, phone and the shared mailbox – links only, nothing loads until tapped
// (ADR-014 2.6). No form, no OTA link (US-151 AC3). Card order follows the page language (ESC-020 L2-A).
import { addressLine, links, site } from '../../content/site';
import type { Copy } from '../../content/types';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const showMail = Boolean(site.contact.email);
const cards = t.contact.order.filter((c) => c !== 'mail' || showMail);
---

<section class="sec alt" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <div class="head">
      <p class="label">{t.contact.label}</p>
      <h2 class="h2" id="contact-h">{t.contact.title}</h2>
      <p class="muted">{t.contact.intro}</p>
    </div>
    <div class="channels">
      {
        cards.map((card) =>
          card === 'intl' ? (
            <div class="ch">
              <p class="label">{t.contact.intl.label}</p>
              <h3 class="h3">{t.contact.intl.title}</h3>
              <p class="num">{site.phone.international}</p>
              <p>{t.contact.intl.text}</p>
              <div class="actions">
                <a class="btn btn-primary btn-sm" href={links.whatsapp()}>
                  WhatsApp
                </a>
                <a class="btn btn-ghost btn-sm" href={links.telegram}>
                  Telegram
                </a>
                <a class="btn btn-ghost btn-sm" href={links.viber}>
                  Viber
                </a>
              </div>
            </div>
          ) : card === 'zalo' ? (
            <div class="ch">
              <p class="label">{t.contact.zalo.label}</p>
              <h3 class="h3">{t.contact.zalo.title}</h3>
              <p class="num">{site.phone.local}</p>
              <p>{t.contact.zalo.text}</p>
              <div class="actions">
                <a class="btn btn-primary btn-sm" href={links.zalo}>
                  {t.contact.zalo.chat}
                </a>
                <a class="btn btn-ghost btn-sm" href={links.tel}>
                  {t.contact.zalo.call}
                </a>
              </div>
            </div>
          ) : (
            <div class="ch ch-mail">
              <p class="label">{t.contact.mail.label}</p>
              <h3 class="h3">{t.contact.mail.title}</h3>
              <p class="num num-sm">
                <a href={links.mail(t.contact.mail.subject)}>{site.contact.email}</a>
              </p>
              <p>{addressLine}</p>
            </div>
          ),
        )
      }
    </div>
    <p class="privacy">{t.contact.privacy}</p>
  </div>
</section>
