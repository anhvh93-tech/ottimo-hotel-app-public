---
// 8 · Contact (concept 6, FB-INV-002 point 4): Zalo is the one filled button; hotline, email and Facebook as text
// links; WhatsApp · Telegram · Viber only behind "Other channels" (the one place). Links only – nothing loads until
// tapped (ADR-014 2.6).
import { links, site } from '../../content/site';
import type { Copy } from '../../content/types';
import Icon from '../Icon.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="sec alt" id="contact" aria-labelledby="contact-h">
  <div class="wrap contact">
    <div class="head">
      <p class="label">{t.contact.label}</p>
      <h2 class="h2" id="contact-h">{t.contact.title}</h2>
      <p class="muted">{t.contact.intro}</p>
    </div>
    <div class="c-main">
      <div class="actions">
        <a class="btn btn-primary" href={links.zalo}><Icon name="chat" />{t.actions.chatOnZalo}</a>
      </div>
      <dl class="c-list">
        <div>
          <dt>Hotline</dt>
          <dd><a href={links.tel}>{site.phone.local}</a></dd>
        </div>
        {
          site.contact.email && (
            <div>
              <dt>Email</dt>
              <dd>
                <a href={links.mail(t.contact.mailSubject)}>{site.contact.email}</a>
              </dd>
            </div>
          )
        }
        {
          site.facebookUrl && (
            <div>
              <dt>Facebook</dt>
              <dd>
                <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer">
                  {t.contact.facebookLink}
                  <span class="sr">{t.actions.newTab}</span>
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      <details class="more">
        <summary>{t.contact.otherChannels}<Icon name="chevron" /></summary>
        <div class="more-body">
          <p>{t.contact.otherText} {site.phone.international}</p>
          <div class="actions">
            <a class="btn btn-ghost btn-sm" href={links.whatsapp()}>WhatsApp</a>
            <a class="btn btn-ghost btn-sm" href={links.telegram}>Telegram</a>
            <a class="btn btn-ghost btn-sm" href={links.viber}>Viber</a>
          </div>
        </div>
      </details>
      <p class="privacy">{t.contact.privacy}</p>
    </div>
  </div>
</section>
