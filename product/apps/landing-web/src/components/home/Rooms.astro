---
// 3 · Rooms (concept 4, US-147): the 4 room types of the e-brochure, one photo each; swipe row on phones, 2 × 2 from
// 768 px. No room count, no unit numbers, no room names until INV sends the mapping (FB-INV-002, BR-012).
// "Request this room" goes to #book and, when the form is on, preselects the room type (data-room).
import type { Copy } from '../../content/types';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="sec alt" id="rooms" aria-labelledby="rooms-h">
  <div class="wrap">
    <div class="head">
      <p class="label">{t.rooms.label}</p>
      <h2 class="h2" id="rooms-h">{t.rooms.title}</h2>
      <p class="muted">{t.rooms.intro}</p>
    </div>
    <ul class="rooms" aria-labelledby="rooms-h">
      {
        t.rooms.items.map((room, i) => (
          <li class="room">
            <Picture
              id={room.photo}
              lang={t.lang}
              alt={t.photoAlt[room.photo]}
              class="r32"
              sizesMobile="calc(80vw - 26px)"
              sizes="(min-width: 1200px) 544px, (min-width: 768px) calc(50vw - 40px), calc(100vw - 32px)"
            />
            <h3 id={`r${i + 1}-h`}>{room.name}</h3>
            <p class="alt-name">
              <span lang={room.altName.lang}>{room.altName.text}</span>
            </p>
            <ul class="specs">
              <li>{t.rooms.sleeps(room.sleeps[0], room.sleeps[1])}</li>
              <li>{room.size}</li>
              <li>{room.view}</li>
            </ul>
            <p class="desc">{room.desc}</p>
            <a class="link" href="#book" data-room={room.slug} aria-describedby={`r${i + 1}-h`}>
              {t.rooms.request}
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="rooms-note">{t.rooms.note}</p>
  </div>
</section>
