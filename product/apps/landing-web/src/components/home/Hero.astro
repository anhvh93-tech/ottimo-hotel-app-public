---
// 1 · Hero (US-146 AC1): facade at dusk (LCP), tagline as the only H1 (English on every page – brand), lead,
// support line in the other language, two actions, four facts.
import { site } from '../../content/site';
import type { Copy } from '../../content/types';
import Picture from '../Picture.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero-grid">
    <Picture
      id="hero-facade-dusk"
      lang={t.lang}
      class="hero-media"
      sizesMobile="100vw"
      sizes="(min-width: 1200px) 640px, (min-width: 1024px) 54vw, 100vw"
      eager
    />
    <div class="hero-text">
      <p class="label">{t.hero.label}</p>
      <h1 id="hero-h" lang="en">{site.tagline}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="support" lang={t.hero.support.lang}>{t.hero.support.text}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#contact">{t.hero.book}</a>
        <a class="btn btn-ghost" href="#rooms">{t.hero.viewRooms}</a>
      </div>
      <ul class="facts">
        {t.hero.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</section>
