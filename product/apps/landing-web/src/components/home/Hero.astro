---
// 1 · Hero (concept 3.1, US-146 AC1): facade at dusk (LCP), label, tagline as the only H1 (English on every page –
// brand), positioning lead (DOM 1.1), Request to book (filled) + Chat on Zalo (outline) – concept 3.3 N2.
import { links, site } from '../../content/site';
import type { Copy } from '../../content/types';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero-grid">
    <Picture
      id="hero-facade-dusk"
      lang={t.lang}
      alt={t.photoAlt['hero-facade-dusk']}
      class="hero-media"
      sizesMobile="100vw"
      sizes="(min-width: 1200px) 640px, (min-width: 1024px) 54vw, 100vw"
      eager
    />
    <div class="hero-text">
      <p class="label">{t.hero.label}</p>
      <h1 id="hero-h" lang="en">{site.tagline}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions" id="hero-actions">
        <a class="btn btn-primary" href="#book">{t.actions.requestToBook}</a>
        <a class="btn btn-ghost" href={links.zalo}><Icon name="chat" />{t.actions.chatOnZalo}</a>
      </div>
    </div>
  </div>
</section>
