---
// 5 · Location (concept 3.1, 11; US-148 AC2): the only place with the address; the INV's Google Maps pin as a
// plain link (no embedded map – SEC C-1); drive times from the e-brochure.
import { addressLine, site } from '../../content/site';
import type { Copy } from '../../content/types';
import Picture from '../Picture.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="sec dark on-dark" id="location" aria-labelledby="loc-h">
  <div class="wrap loc">
    <div>
      <p class="label">{t.location.label}</p>
      <h2 class="h2" id="loc-h">{t.location.title}</h2>
      <p class="muted">{t.location.intro}</p>
      <address><span id="addr-text">{addressLine}</span></address>
      <div class="actions">
        <a class="btn btn-ghost" target="_blank" rel="noopener noreferrer" href={site.mapUrl}
          >{t.location.maps}<span class="sr">{t.actions.newTab}</span></a
        >
        <button
          type="button"
          class="btn btn-ghost"
          id="copy-addr"
          data-copied={t.location.copied}
          data-failed={t.location.copyFailed}>{t.location.copy}</button
        >
      </div>
      <p class="status" id="copy-status" role="status" aria-live="polite"></p>
      <table class="dist">
        <caption>{t.location.caption}</caption>
        <thead class="sr">
          <tr>
            <th scope="col">{t.location.head.place}</th>
            <th scope="col">{t.location.head.distance}</th>
            <th scope="col">{t.location.head.time}</th>
          </tr>
        </thead>
        <tbody>
          {
            t.location.rows.map((r) => (
              <tr>
                <th scope="row">{r.place}</th>
                <td>{r.distance}</td>
                <td>{r.time}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="small muted">{t.location.note}</p>
    </div>
    <Picture
      id="aerial-hillside"
      lang={t.lang}
      alt={t.photoAlt['aerial-hillside']}
      sizesMobile="calc(100vw - 32px)"
      sizes="(min-width: 1200px) 480px, (min-width: 1024px) 40vw, calc(100vw - 48px)"
    />
  </div>
</section>
