---
// 2 · Two ways to stay (US-146 AC1: short stay / monthly, each leading on).
import type { Copy } from '../../content/types';
import Arrow from '../Arrow.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<section class="stay-sec" aria-label={t.stay.region}>
  <div class="wrap stay">
    <div class="stay-card">
      <h2 class="h3">{t.stay.fewNights.title}</h2>
      <p>{t.stay.fewNights.body}</p>
      <a class="link" href="#contact">{t.stay.fewNights.link}<Arrow /></a>
    </div>
    <div class="stay-card">
      <h2 class="h3">{t.stay.longer.title}</h2>
      <p>{t.stay.longer.body}</p>
      <a class="link" href="#faq-monthly">{t.stay.longer.link}<Arrow /></a>
    </div>
  </div>
</section>
