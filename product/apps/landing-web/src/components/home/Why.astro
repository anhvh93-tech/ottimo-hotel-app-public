---
// 2 · Why OTTIMO (concept 2.2): the dual promise – a few nights / a month or longer, two equal cards.
import type { Copy } from '../../content/types';
import Picture from '../Picture.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const cards = [
  ['p1-h', t.why.short],
  ['p2-h', t.why.long],
] as const;
const SIZES = '(min-width: 1200px) 544px, (min-width: 768px) calc(50vw - 40px), calc(100vw - 32px)';
---

<section class="sec" id="why" aria-labelledby="why-h">
  <div class="wrap">
    <div class="head why-intro">
      <p class="label">{t.why.label}</p>
      <h2 class="h2" id="why-h">{t.why.title}</h2>
      <p class="muted">{t.why.intro}</p>
    </div>
    <div class="promise">
      {
        cards.map(([id, c]) => (
          <article aria-labelledby={id}>
            <Picture
              id={c.photo}
              lang={t.lang}
              alt={t.photoAlt[c.photo]}
              class="r32"
              sizesMobile="calc(100vw - 32px)"
              sizes={SIZES}
            />
            <p class="label">{c.label}</p>
            <h3 class="h3" id={id}>
              {c.title}
            </h3>
            <p>{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
