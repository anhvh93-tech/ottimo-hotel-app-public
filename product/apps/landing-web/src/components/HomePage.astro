---
// The one-page landing (concept v1.2.1, 8 sections): Hero → Why → Rooms → Amenities → Location → Book → FAQ →
// Contact, rendered once per published language.
import type { Copy } from '../content/types';
import Base from '../layouts/Base.astro';
import Amenities from './home/Amenities.astro';
import Book from './home/Book.astro';
import Contact from './home/Contact.astro';
import Faq from './home/Faq.astro';
import Hero from './home/Hero.astro';
import Location from './home/Location.astro';
import Rooms from './home/Rooms.astro';
import Why from './home/Why.astro';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<Base t={t} title={t.meta.title} description={t.meta.description}>
  <Hero t={t} />
  <Why t={t} />
  <Rooms t={t} />
  <Amenities t={t} />
  <Location t={t} />
  <Book t={t} />
  <Faq t={t} />
  <Contact t={t} />
</Base>
