---
// Phone action bar (< 768 px, concept 3.1/3.3 N2): same hierarchy as the hero – "Plan your stay" filled (3/5),
// "Chat on Zalo" outline (2/5; "Zalo" + icon under 360 px). Rendered hidden; scripts/main.ts shows it only while the
// hero buttons, #book, #contact and the footer are all off screen. No JavaScript: nojs.css shows it.
import { links } from '../content/site';
import type { Copy } from '../content/types';
import Icon from './Icon.astro';

interface Props {
  t: Copy;
  home: string;
}

const { t, home } = Astro.props;
---

<nav class="stickybar" id="stickybar" aria-label={t.sticky.label} data-hidden="true">
  <a class="sb sb-book" href={`${home}#book`}>{t.actions.requestToBook}</a>
  <a class="sb sb-zalo" href={links.zalo}
    ><Icon name="chat" /><span><span class="sb-long">{t.actions.chatOnPrefix}</span>Zalo</span></a
  >
</nav>
