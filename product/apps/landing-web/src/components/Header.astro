---
// Sticky header (concept 3.1 row 0). Language switch = plain links to the same page in each published language,
// always visible (ADR-014 3.2 point 5); the full language name is in aria-label (starts with the visible "EN"/"VI",
// WCAG 2.5.3) – not as hidden text, which would pull the Vietnamese 500 font file into the English page (~12 KB). From 768 px: text link "Chat on Zalo" + outline "Request to book" (N4) –
// never a filled button, so it does not compete with the hero.
import { links } from '../content/site';
import type { Copy } from '../content/types';
import { LANGS, LANG_NAME, pathFor } from '../lib/i18n';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';

interface Props {
  t: Copy;
  slug: string;
  /** '' on the home page (in-page anchors); the home path elsewhere (404). */
  home: string;
}

const { t, slug, home } = Astro.props;
const desktopNav = [
  ['#rooms', t.nav.rooms],
  ['#amenities', t.nav.amenities],
  ['#location', t.nav.location],
  ['#faq', t.nav.faq],
] as const;
const mobileNav = [
  ['#why', t.nav.why],
  ['#rooms', t.nav.rooms],
  ['#amenities', t.nav.amenities],
  ['#location', t.nav.location],
  ['#book', t.actions.requestToBook],
  ['#faq', t.nav.faq],
  ['#contact', t.nav.contact],
] as const;
---

<header class="site-h">
  <div class="wrap h-row">
    <a class="brand" href={`${home}#top`}>
      <Monogram />
      <span class="brand-div" aria-hidden="true"></span>
      <span class="wm"><span class="wm-name">OTTIMO</span> <span class="wm-sub">Boutique Stay</span></span>
    </a>
    <nav class="nav-d" aria-label={t.nav.label}>
      {desktopNav.map(([hash, label]) => <a href={`${home}${hash}`}>{label}</a>)}
    </nav>
    <div class="h-tools">
      <div class="lang" role="group" aria-label={t.langSwitch.label}>
        {
          LANGS.map((l) => (
            <a
              href={pathFor(l, slug)}
              hreflang={l}
              lang={l}
              data-set-lang={l}
              aria-current={l === t.lang ? 'page' : undefined}
              aria-label={`${l.toUpperCase()} – ${LANG_NAME[l]}`}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <a class="h-zalo" href={links.zalo}><Icon name="chat" />{t.actions.chatOnZalo}</a>
      <a class="btn btn-ghost btn-sm only-d" href={`${home}#book`}>{t.actions.requestToBook}</a>
      <details class="menu">
        <summary aria-label={t.nav.menu}><Icon name="menu" /></summary>
        <nav class="menu-panel" aria-label={t.nav.mobileLabel}>
          {mobileNav.map(([hash, label]) => <a href={`${home}${hash}`}>{label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
