---
// Sticky header (concept 3.1 row 0). From 768 px: text link "Chat on Zalo" + outline "Plan your stay" (N4) – never a
// filled button, so it does not compete with the hero.
// Language switch (LP-v2, UXD lp-v2-design 2.2; ADR-014 3.2 point 5 as amended by UXD 2.3): a globe + the code of the
// page language, always visible at the top; it opens the list of the 5 languages, each written in itself, each a plain
// link to the same page (<details> – works without JavaScript; no role="menu"). The accessible name starts with the
// visible code (WCAG 2.5.3). Language names carry their own `lang`: on another language's page they use the system
// font (ARC lp-v2 3.3 rule 3) – the closed list draws nothing, so the page loads no Korean/Chinese/Cyrillic font file.
import { links } from '../content/site';
import type { Copy } from '../content/types';
import { HTML_LANG, LANGS, LANG_NAME, pathFor } from '../lib/i18n';
import Icon from './Icon.astro';
import LangIcon from './LangIcon.astro';
import Monogram from './Monogram.astro';

interface Props {
  t: Copy;
  slug: string;
  /** '' on the home page (in-page anchors); the home path elsewhere (404). */
  home: string;
}

const { t, slug, home } = Astro.props;
const desktopNav = [
  ['#rooms', t.nav.rooms],
  ['#amenities', t.nav.amenities],
  ['#location', t.nav.location],
  ['#faq', t.nav.faq],
] as const;
const mobileNav = [
  ['#why', t.nav.why],
  ['#rooms', t.nav.rooms],
  ['#amenities', t.nav.amenities],
  ['#location', t.nav.location],
  ['#book', t.actions.requestToBook],
  ['#faq', t.nav.faq],
  ['#contact', t.nav.contact],
] as const;
---

<header class="site-h">
  <div class="wrap h-row">
    <a class="brand" href={`${home}#top`}>
      <Monogram />
      <span class="brand-div" aria-hidden="true"></span>
      <span class="wm"><span class="wm-name">OTTIMO</span> <span class="wm-sub">Boutique Stay</span></span>
    </a>
    <nav class="nav-d" aria-label={t.nav.label}>
      {desktopNav.map(([hash, label]) => <a href={`${home}${hash}`}>{label}</a>)}
    </nav>
    <div class="h-tools">
      <details class="lang-pick">
        <summary aria-label={`${t.lang.toUpperCase()} – ${t.langSwitch.label}: ${LANG_NAME[t.lang]}`}>
          <LangIcon name="globe" />
          <span class="lp-cur">{t.lang.toUpperCase()}</span>
          <Icon name="chevron" class="lp-chev" />
        </summary>
        <div class="lp-panel">
          <p class="lp-h" aria-hidden="true">{t.langSwitch.label}</p>
          <ul>
            {
              LANGS.map((l) => (
                <li>
                  <a
                    href={pathFor(l, slug)}
                    hreflang={l}
                    lang={HTML_LANG[l]}
                    data-set-lang={l}
                    aria-current={l === t.lang ? 'page' : undefined}
                  >
                    <LangIcon name="check" class="lp-ck" />
                    {LANG_NAME[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
      <a class="h-zalo" href={links.zalo}><Icon name="chat" />{t.actions.chatOnZalo}</a>
      <a class="btn btn-ghost btn-sm only-d" href={`${home}#book`}>{t.actions.requestToBook}</a>
      <details class="menu">
        <summary aria-label={t.nav.menu}><Icon name="menu" /></summary>
        <nav class="menu-panel" aria-label={t.nav.mobileLabel}>
          {mobileNav.map(([hash, label]) => <a href={`${home}${hash}`}>{label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
