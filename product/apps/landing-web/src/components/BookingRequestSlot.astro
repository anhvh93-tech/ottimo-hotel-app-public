---
// Guard: the live booking request needs a transport (endpoint by ARC/BE) – not built yet. Turning the feature flag
// on before that fails the build instead of publishing a form that cannot send (src/lib/booking-request.ts).
import { BOOKING_REQUEST_ENABLED } from '../lib/booking-request';

if (BOOKING_REQUEST_ENABLED) {
  throw new Error(
    'site.json features.bookingRequest is on but the booking-request transport is not built yet ' +
      '(endpoint: ARC/BE – ADR-014 4.8) – see src/lib/booking-request.ts',
  );
}
