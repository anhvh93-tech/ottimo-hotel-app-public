---
// Guard for the live booking request (lib/booking-request.ts): the transport is built (OpenAPI 0.3.7 add-on 2,
// public-site), so the live form only needs its build settings – a property slug and the published privacy notice.
// Missing → the build stops instead of publishing a form that cannot send.
import {
  BOOKING_REQUEST_ENABLED,
  PRIVACY_NOTICE_VERSION,
  PROPERTY_SLUG_PATTERN,
  PUBLIC_PROPERTY_SLUG,
} from '../lib/booking-request';

if (BOOKING_REQUEST_ENABLED && !PROPERTY_SLUG_PATTERN.test(PUBLIC_PROPERTY_SLUG)) {
  throw new Error('LANDING_BOOKING_FORM=true needs LANDING_PROPERTY_SLUG (lib/booking-request.ts)');
}
if (BOOKING_REQUEST_ENABLED && !PRIVACY_NOTICE_VERSION) {
  throw new Error('The live booking form needs the privacy notice version (content/privacy.ts)');
}
