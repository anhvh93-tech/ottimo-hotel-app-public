---
// Footer (concept 3.1, N1): lockup on Ink, tagline, one row of links (Zalo · Facebook · Email), © and – once SEC
// publishes it – the privacy notice. Address, hotline and other channels live in Location / Contact only.
// Legal line (INV 22/10): operator, tax code and registered address, as registered (Vietnamese) on every page.
import { links, site } from '../content/site';
import type { Copy } from '../content/types';
import { pathFor } from '../lib/i18n';
import Monogram from './Monogram.astro';

interface Props {
  t: Copy;
  home: string;
}

const { t, home } = Astro.props;
const year = 2026;
---

<footer class="site-f dark on-dark">
  <div class="wrap">
    <div class="f-grid">
      <div>
        <a class="brand" href={`${home}#top`}>
          <Monogram />
          <span class="brand-div" aria-hidden="true"></span>
          <span class="wm"><span class="wm-name">OTTIMO</span> <span class="wm-sub">Boutique Stay</span></span>
          <span class="sr">{t.footer.backToTop}</span>
        </a>
        <p class="tagline" lang="en">{site.tagline}</p>
      </div>
      <ul class="f-links" aria-label={t.footer.links}>
        <li><a href={links.zalo}>Zalo</a></li>
        {
          site.facebookUrl && (
            <li>
              <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer">
                Facebook<span class="sr">{t.actions.newTab}</span>
              </a>
            </li>
          )
        }
        {
          site.contact.email && (
            <li>
              <a href={links.mail(t.contact.mailSubject)}>Email</a>
            </li>
          )
        }
      </ul>
    </div>
    <p class="f-legal">
      <span>{t.footer.operator} <span lang="vi">{site.legal.name}</span></span>
      <span>{t.footer.taxCode} <span class="nw">{site.legal.taxCode}</span></span>
      <span lang="vi">{site.legal.address}</span>
    </p>
    <div class="f-base">
      <span>© {year} {site.name} · {t.footer.place}</span>
      {site.features.privacyPage && <a href={pathFor(t.lang, 'privacy')}>{t.footer.privacy}</a>}
    </div>
  </div>
</footer>
