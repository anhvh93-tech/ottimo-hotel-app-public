---
// Language suggestion (ADR-014 3.2 point 3): one hidden strip per other published language, written in that
// language, linking to the same page there. src/scripts/lang.ts shows at most one, never redirects.
// data-nosnippet keeps it out of search snippets; position: fixed, so showing it causes no layout shift.
import { COPY } from '../content';
import { HTML_LANG, LANGS, pathFor, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const others = LANGS.filter((l) => l !== lang);
---

{
  others.map((l) => (
    <section
      class="lang-suggest"
      lang={HTML_LANG[l]}
      data-suggest={l}
      data-nosnippet
      hidden
      aria-label={COPY[l].langSuggest.region}
    >
      <div class="wrap ls-row">
        <a class="ls-link" href={pathFor(l, slug)} hreflang={l} data-set-lang={l}>
          {COPY[l].langSuggest.text}
        </a>
        <button type="button" class="ls-close" data-ls-close>
          {COPY[l].langSuggest.close}
        </button>
      </div>
    </section>
  ))
}
