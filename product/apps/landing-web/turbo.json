{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": [
        "LANDING_SITE_URL",
        "LANDING_INDEXABLE",
        "LANDING_BOOKING_FORM",
        "LANDING_PROPERTY_SLUG",
        "PUBLIC_FORM_API_BASE"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/api-client/src/generated/openapi.ts"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "LANDING_SITE_URL",
        "LANDING_INDEXABLE",
        "LANDING_BOOKING_FORM",
        "LANDING_PROPERTY_SLUG",
        "PUBLIC_FORM_API_BASE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/design/wireframes/assets/tokens.css",
        "$TURBO_ROOT$/.prettierrc.json"
      ],
      "outputs": ["dist-booking-preview/**", "dist-booking-live/**"]
    }
  }
}
