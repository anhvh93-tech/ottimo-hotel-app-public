{
  "name": "@ottimo/landing-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public landing site at the root domain (ADR-014, EP19 LP-v1): static Astro build, EN at /, VI at /vi/, no third-party resources",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 5176",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:booking-preview": "ASTRO_TELEMETRY_DISABLED=1 LANDING_BOOKING_PREVIEW=true LANDING_OUT_DIR=dist-booking-preview astro build",
    "build:booking-live-test": "ASTRO_TELEMETRY_DISABLED=1 LANDING_BOOKING_FORM=true LANDING_PROPERTY_SLUG=dl01 LANDING_OUT_DIR=dist-booking-live astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 5176",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "pnpm run build:booking-preview && pnpm run build:booking-live-test && vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "og": "node scripts/make-og.mjs",
    "clean": "rm -rf dist dist-booking-preview dist-booking-live .astro"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/sitemap": "3.7.4",
    "@types/node": "^22.10.2",
    "astro": "7.4.1",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
