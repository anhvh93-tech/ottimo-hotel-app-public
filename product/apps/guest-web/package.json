{
  "name": "@ottimo/guest-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Guest web app (link/QR per booking) – React + Vite, ADR-006. R2: level-1 session only (SEC P-R2-4 ĐK-1…6)",
  "scripts": {
    "dev": "vite",
    "dev:server": "VITE_API_MODE=server vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ottimo/api-client": "workspace:*",
    "@ottimo/i18n": "workspace:*",
    "@ottimo/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
