# syntax=docker/dockerfile:1
# Image for both `api` and `worker` (ADR-001/003). Build context = product/
#   docker build -f infra/docker/Dockerfile.api -t ottimo-api .
# Base images pinned by digest (FB-R1-SEC-OPS-07); Dependabot (docker) updates tag + digest.
# Node >= 22.12 is required: the CommonJS api require()s the ESM workspace packages (FB-R1-ARC-OPS-01).
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
RUN npm install -g pnpm@9.15.4
WORKDIR /repo

# Prune the workspace to @ottimo/api and its workspace deps (FB-R1-ARC-OPS-06): out/json = manifests +
# pruned lockfile (install layer only changes when dependencies change), out/full = sources.
FROM base AS prune
RUN npm install -g turbo@2.11.8
COPY . .
RUN turbo prune @ottimo/api --docker

FROM base AS build
COPY --from=prune /repo/out/json/ .
# Lockfile is mandatory (ADR-012, FB-R1-SEC-OPS-05, SEC-R1-24): no lockfile or a stale one = build fails.
RUN pnpm install --frozen-lockfile
COPY --from=prune /repo/out/full/ .
# Root config that turbo prune does not copy (shared compiler options).
COPY --from=prune /repo/tsconfig.base.json ./
RUN pnpm exec turbo run build --filter=@ottimo/api...
# Test-only endpoints (/__test__/*, TestSupportModule – openapi.test.yaml, ADR-008) live in
# services/api/src/test-support/. Default image = production build: the folder is removed from dist and
# CI fails if "__test__"/"TestSupportModule" remain anywhere (BUG-R1-SEC-08, infra/ci/check-no-test-surface.sh).
# dev/staging images that need it: docker build --build-arg INCLUDE_TEST_SUPPORT=1 ...
ARG INCLUDE_TEST_SUPPORT=0
RUN if [ "$INCLUDE_TEST_SUPPORT" != "1" ]; then rm -rf services/api/dist/test-support; fi
RUN pnpm --filter=@ottimo/api deploy --prod /out

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./package.json
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/services/api/dist ./dist
# Encrypted blob store (ADR-013 point 1, SEC C2 / SR-FILE-04): mount point of the blob volume, owned by `node`,
# mode 0700. A NEW named volume mounted here copies this owner/mode, so api and worker can write and nobody
# else can list it. BLOBSTORE_LOCAL_PATH is NOT set in the image on purpose: compose must name the path
# (staging/production refuse to start without an absolute one), so a forgotten volume fails loudly instead of
# writing guest documents into a container layer. Never mounted into the web (Caddy) container.
RUN mkdir -p /var/lib/ottimo/blobs \
    && chown node:node /var/lib/ottimo/blobs \
    && chmod 0700 /var/lib/ottimo/blobs
# sharp (SR-FILE-03) loads its prebuilt linuxmusl binary (@img/sharp-linuxmusl-*), no build tools needed;
# fail the build here rather than at the first upload if the platform package is missing.
RUN node -e "const s=require('sharp');if(!s.versions||!s.versions.vips)process.exit(1);console.log('sharp',s.versions.sharp,'vips',s.versions.vips)"
# No secrets in the image: all config comes from environment variables (or *_FILE secrets) at runtime.
# APP_ENV is deliberately NOT set here: the app refuses to start until the environment says what it is.
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
