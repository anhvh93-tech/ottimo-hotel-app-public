# syntax=docker/dockerfile:1
# Image for both `api` and `worker` (ADR-001/003). Build context = product/
#   docker build -f infra/docker/Dockerfile.api -t ottimo-api .
# Base images pinned by digest (FB-R1-SEC-OPS-07); Dependabot (docker) updates tag + digest.
# Node >= 22.12 is required: the CommonJS api require()s the ESM workspace packages (FB-R1-ARC-OPS-01).
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
RUN npm install -g pnpm@9.15.4
WORKDIR /repo

FROM base AS build
COPY . .
# Lockfile is mandatory once committed (ADR-012). Until the first `pnpm install` is committed,
# fall back to a non-frozen install and say so loudly. R2: remove the fallback (FB-R1-SEC-OPS-05)
# and switch to `turbo prune @ottimo/api --docker` (FB-R1-ARC-OPS-06), which needs the lockfile.
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; \
    else echo "WARNING: pnpm-lock.yaml missing - non-reproducible install" && pnpm install --no-frozen-lockfile; fi
RUN pnpm exec turbo run build --filter=@ottimo/api...
# Test-only endpoints (/__test__/*, TestSupportModule – openapi.test.yaml, ADR-008) live in
# services/api/src/test-support/. Default image = production build: the folder is removed from dist and
# CI fails if "__test__"/"TestSupportModule" remain anywhere (BUG-R1-SEC-08, infra/ci/check-no-test-surface.sh).
# dev/staging images that need it: docker build --build-arg INCLUDE_TEST_SUPPORT=1 ...
ARG INCLUDE_TEST_SUPPORT=0
RUN if [ "$INCLUDE_TEST_SUPPORT" != "1" ]; then rm -rf services/api/dist/test-support; fi
RUN pnpm --filter=@ottimo/api deploy --prod /out

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./package.json
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/services/api/dist ./dist
# No secrets in the image: all config comes from environment variables (or *_FILE secrets) at runtime.
# APP_ENV is deliberately NOT set here: the app refuses to start until the environment says what it is.
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
