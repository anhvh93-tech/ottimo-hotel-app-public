# Periodic checks of the stack /opt/%i (infra/server/bin/ops-check.sh) – production: ottimo-ops-check@ottimo-prod.
[Unit]
Description=OTTIMO ops checks of /opt/%i
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ottimo
Group=ottimo
# v1.0.5 V5-63: check `journal` reads the host journal – the group is given to this unit only, not to the user.
SupplementaryGroups=systemd-journal
Environment=OTTIMO_HOME=/opt/%i
ExecStart=/opt/%i/infra/server/bin/ops-check.sh
