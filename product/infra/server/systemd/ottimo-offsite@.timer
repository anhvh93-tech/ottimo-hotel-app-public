# 04:00 and 16:00 Vietnam time = 1 h after the production backups (03:00 + 15:00, ottimo-backup@.timer); Persistent =
# run at boot if the server was off. The Apps Script mover moves the files from Nhận to Kho within the next hour.
[Unit]
Description=OTTIMO off-site copy of /opt/%i to Google Drive, twice a day

[Timer]
OnCalendar=*-*-* 04:00:00 Asia/Ho_Chi_Minh
OnCalendar=*-*-* 16:00:00 Asia/Ho_Chi_Minh
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
