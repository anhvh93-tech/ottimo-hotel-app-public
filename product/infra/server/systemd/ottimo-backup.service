# Daily encrypted backup (infra/server/bin/backup.sh) – installed by bootstrap-vps.sh.
[Unit]
Description=OTTIMO encrypted backup (database, blobs, purge_journal)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ottimo
Group=ottimo
Environment=OTTIMO_HOME=/opt/ottimo
ExecStart=/opt/ottimo/infra/server/bin/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
