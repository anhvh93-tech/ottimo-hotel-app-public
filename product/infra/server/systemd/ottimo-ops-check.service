# Periodic checks (infra/server/bin/ops-check.sh): J16 retention < 26 h (SEC C6), backup, disk, TLS, containers.
# A failing check exits 1 → this unit shows "failed" in `systemctl --failed` too; alerts: journalctl -t ottimo-alert.
[Unit]
Description=OTTIMO ops checks (J16 retention, backup, disk, TLS, containers)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ottimo
Group=ottimo
Environment=OTTIMO_HOME=/opt/ottimo
ExecStart=/opt/ottimo/infra/server/bin/ops-check.sh
