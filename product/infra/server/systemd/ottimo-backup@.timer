# 03:00 Vietnam time for production (staging runs at 03:30 – the two dumps never overlap); Persistent = run at boot
# if the server was off.
[Unit]
Description=OTTIMO daily backup of /opt/%i

[Timer]
OnCalendar=*-*-* 03:00:00 Asia/Ho_Chi_Minh
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
