# OTTIMO Desk – server settings, PRODUCTION (TEMPLATE). bootstrap-vps.sh --env production copies it to
# /opt/ottimo-prod/.env (0600, deploy user); fill the <...>. Staging has its own: env.example (→ /opt/ottimo/.env).
# deploy.sh refuses production unless MFA_ENFORCED=true, CLOCK_MODE=system, no test image/switch, released digests.
# NON-SECRET values only. Keys and passwords live in /opt/ottimo/secrets/ (infra/server/bin/init-secrets.sh) and
# reach the containers as *_FILE – never write them here, never commit the filled file.
# Read by infra/server/bin/dc → docker compose --env-file (interpolation of infra/docker-compose.prod.yml).

# ---------- environment ----------
# staging | production (the api refuses anything weaker outside dev/test: https origins, keys, TRUST_PROXY…)
APP_ENV=production
LOG_LEVEL=info
# production: system only.
CLOCK_MODE=system
# US-143 (SEC 06.3, INV 23/10 v1.0 condition 2): two-step login for owner/manager – production MUST be true.
MFA_ENFORCED=true

# ---------- stack on the shared VPS (R3 v1.0 – rounds/round-03/outputs/OPS/v1-production.md 2) ----------
# Compose project (volumes/networks are prefixed with it). Staging keeps `ottimo` (its existing volumes).
OTTIMO_PROJECT=ottimo-prod
# direct = this stack publishes 80/443 itself (only possible while it is alone on the VPS);
# edge   = behind the shared edge (infra/edge, bin/edge.sh up) – required once production runs next to it.
EDGE_MODE=edge
# edge mode: staging | production (link network ottimo-link-<name>, aliases <name>-web / <name>-landing)
EDGE_NAME=production
# edge mode: the edge's fixed address on that network – the only sender of PROXY protocol headers (staging 172.31.1.2)
PROXY_PROTOCOL_ALLOW=172.31.2.2/32
# Memory limits (two stacks share 4.8 GB): production keeps the compose defaults.
PG_MEM_LIMIT=1g
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=768m

# ---------- host names (DNS A records → this VPS – hosting-plan 5.1 / 10) ----------
DESK_HOST=desk.<domain>
STAFF_HOST=staff.<domain>
GUEST_HOST=g.<domain>
# Let's Encrypt account e-mail (expiry warnings). A team mailbox, not a personal one.
ACME_EMAIL=<ops-mailbox>@<domain>
# Landing (ADR-014; deploy-landing.sh): the public site at the root domain, www → 301 to it.
LANDING_HOST=<domain>
LANDING_WWW_HOST=www.<domain>
LANDING_IMAGE=ghcr.io/<github-owner>/ottimo-landing
# api: origin of the website form (v1.1, US-155). Empty = website form off.
LANDING_BASE_URL=
# US-155 website form (go-live: SEC s1-SEC-on-us155 conditions 1–7, then OWN switches public_booking_requests_enabled):
#   LANDING_BASE_URL=https://ottimo.vn  (https, exactly the landing origin – deploy.sh / deploy-landing.sh refuse other)
#   LANDING_PUBLIC_API=on               (Caddyfile.landing proxies the two public operations to this stack's api)
# and a landing image built with LANDING_BOOKING_FORM=true + LANDING_PROPERTY_SLUG=dlt (repository variables).
LANDING_PUBLIC_API=off

# ---------- images (built and pushed by CI – .github/workflows/ci.yml job publish-images) ----------
API_IMAGE=ghcr.io/<github-owner>/ottimo-api
WEB_IMAGE=ghcr.io/<github-owner>/ottimo-web
# Production: always empty (no test image). IMAGE_TAG is NOT set here: deploy.sh records it in state/.
API_TAG_SUFFIX=

# ---------- test switches: never in production (the api and deploy.sh refuse them) ----------
INCLUDE_TEST_SUPPORT=0
TEST_SUPPORT_TOKEN=
TEST_SUPPORT_ALLOW_IPS=127.0.0.1/32

# ---------- monitoring ----------
# Space separated IPs/CIDRs of an external uptime monitor allowed to GET https://<host>/health (empty = Docker
# network only).
HEALTH_ALLOW_IPS=
# Optional: webhook that receives ops-check alerts as JSON {"text": "..."} (Slack/Mattermost/Google Chat style).
# Empty = alerts go to the system journal only (journalctl -t ottimo-alert). Contains no personal data.
ALERT_WEBHOOK_URL=
# Optional: dead-man switch (e.g. a free healthchecks.io check URL) pinged after every ops-check run, /fail on failure.
HEARTBEAT_URL=

# ---------- Web Push (R3, US-164) ----------
# VAPID "subject": a mailto: of the team. The key pair itself is generated on the server (init-secrets.sh) – never here.
WEB_PUSH_SUBJECT=mailto:<ops-mailbox>@<domain>

# ---------- network (production: 172.30.1.0/24 – staging uses 172.30.0.0/24 on the same VPS) ----------
EDGE_SUBNET=172.30.1.0/24
WEB_IP=172.30.1.10
# Landing container on the same network (US-155 form proxy) – the api trusts it next to WEB_IP.
LANDING_IP=172.30.1.11

# ---------- integrations (R2: everything off / manual / mock – integrations/README.md 4) ----------
CHANNEL_PROVIDER=off
PAYMENT_METHODS_ENABLED=vietqr
# production rule (b) of integrations/common/safe-config.ts: every method listed above needs PAYMENT_<X>_MODE=production,
# otherwise api/worker refuse to start (26/10/2026 first deploy). VietQR "production" = QR string generated locally to
# the account in the payment_receiving_account parameter – no external service, no money moved by the app.
PAYMENT_VIETQR_MODE=production
# The VietQR receiving account is NOT set here: OWN enters it in the app (Parameters → payment_receiving_account,
# password re-auth). PAYMENT_VIETQR_BANK_BIN/_ACCOUNT_NO/_ACCOUNT_NAME are retired – non-empty = api refuses to start.
PAYMENT_VNPAY_MODE=off
PAYMENT_MOMO_MODE=off
BANKFEED_PROVIDER=off
EINVOICE_PROVIDER=off
DOORLOCK_PROVIDER=manual
# E-mail (INV 23/10/2026, replaces ESC-010 B Amazon SES for v1.0): Google Workspace SMTP from info@ottimo.vn.
# production refuses to start unless EMAIL_PROVIDER=smtp (2FA / receiving-account e-mails – SEC 06.15/06.33/Q51-6).
# Never a password here. Port 465 = TLS, 587 = STARTTLS (both verified certificates); no other port.
# SEC FB-R3-SEC-INT-EMAIL-01 A: Google Workspace SMTP relay, authenticated by the IP of this VPS (Admin console →
# Gmail → Routing → SMTP relay service: only this IP, only addresses in our domains, require TLS). No password on
# the server – the secret file email_smtp_password stays empty. Fallback only after ORC/INV agree:
# EMAIL_SMTP_MODE=app_password + EMAIL_SMTP_USER=info@ottimo.vn + an app password typed into init-secrets.sh.
EMAIL_PROVIDER=smtp
EMAIL_FROM=info@ottimo.vn
EMAIL_SMTP_MODE=relay
EMAIL_SMTP_HOST=smtp-relay.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
ZALO_PROVIDER=manual_copy
# Google Chat room "OTTIMO – Yêu cầu đặt phòng" (ARC gchat-booking-request-notify; SEC ESC-041). The webhook URL is
# NOT here: it is the worker-only secret file booking_request_chat_webhook (init-secrets.sh --set-booking-chat).
# Level of the first message: A (code, times, Desk link – default) | B (+ dates, guests) | C (+ name, contact,
# message). Unset or invalid = A. C only after SEC confirms ESC-041 ★1–★8 in the decision log; requests sent under a
# notice older than 2026-10-31 always get A (code constant). Changing this line = .env change → tell INV first, then
# bin/dc up -d worker and check the log line "chat detail level".
BOOKING_REQUEST_CHAT_DETAIL_LEVEL=A
