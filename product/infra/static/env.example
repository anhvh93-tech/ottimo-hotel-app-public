# /opt/ottimo-static/.env – secondary static site (infra/static, runbook infra/server/README.md section 14).
# Copy to the server, fill in, chmod 0640 root:ottimo. NO secret in this file (none is needed). Never commit the real file.
# Both names together or none: edge.sh routes them only when both are set; empty = the site is not routed.
STATIC_HOST=example.test
STATIC_WWW_HOST=www.example.test
# ACME account contact (certificate expiry notices) – an address of the site's owner.
ACME_EMAIL=ops@example.test
# Web root on the host (read-only in the container, files must be readable by uid 10001: dirs 0755, files 0644).
STATIC_ROOT=/opt/ottimo-static/site
