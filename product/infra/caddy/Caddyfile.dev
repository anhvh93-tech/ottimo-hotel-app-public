# DEV ONLY – plain HTTP on localhost, mounted by infra/docker-compose.yml (not baked into the image).
# No `log` directive on purpose: dev Caddy writes no access log, so no query strings or /g/* tokens.
# Production Caddyfile (R2): TLS, CSP/HSTS/Referrer-Policy, 3 origins (SR-HDR-01..04), access log with
# /g/* and every query string masked (incl. /v1/webhooks/* – VNPay GET IPN), /health restricted to internal/monitoring (FB-R1-SEC-OPS-11/12).
{
	admin off
	auto_https off
}

(spa) {
	root * /srv/{args[0]}
	encode gzip
	header X-Content-Type-Options nosniff
	handle /health {
		reverse_proxy api:3000
	}
	handle /v1/* {
		reverse_proxy api:3000
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

# admin-web (front desk, manager, owner)
:8081 {
	import spa admin-web
}

# mobile – OTTIMO Staff PWA
:8082 {
	import spa mobile
}

# guest-web
:8083 {
	import spa guest-web
}
