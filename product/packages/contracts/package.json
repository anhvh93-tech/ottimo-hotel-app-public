{
  "name": "@ottimo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared API types. R2: generated from docs/api/openapi.yaml (openapi-typescript) + zod schemas.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^5.0.5"
  }
}
